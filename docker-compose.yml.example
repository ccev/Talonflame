services:
  talonflame:
    build: .
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./config.toml:/talonflame/config.toml:ro
      - /run/mysqld:/run/mysqld:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:9042/healthz"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 60s
